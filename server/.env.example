# Server only. Never paste this key into the phone/watch app or commit it.
OPENAI_API_KEY=
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Development device token, NOT a production account/subscription system.
DEVICE_TOKEN=
HOST=127.0.0.1
PORT=8787
# This prototype uses the documented full-duplex voice interface with a strict
# translation-only prompt. It does not silently emulate the dedicated translator.
LIVE_MODEL=gpt-live-1
SESSION_MAX_SECONDS=300
MAX_SESSIONS=1
